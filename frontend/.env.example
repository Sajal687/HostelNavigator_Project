# Copy to .env.local for local development. On Netlify, set these under
# Site settings -> Environment variables. CRA only exposes vars prefixed with REACT_APP_.
# These values are baked into the public JS bundle - never put secrets here.

# Backend API base URL (no trailing slash)
#   Local:      http://localhost:8080
#   Production: https://hostelnavigatorbackend.onrender.com
REACT_APP_API_URL=http://localhost:8080
