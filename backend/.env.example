# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=8080
NODE_ENV=development

# MongoDB Atlas connection string (MONGO_URI is still accepted as a legacy alias)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hostelnavigator?retryWrites=true&w=majority

# JWT signing secret - REQUIRED when NODE_ENV=production (the server refuses to start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Allowed browser origins (comma-separated). If unset, defaults to the production
# domains plus http://localhost:3000. Add Netlify preview URLs here if you use them.
CORS_ORIGIN=https://hostelnavigator.online,https://www.hostelnavigator.online,http://localhost:3000
CLIENT_URL=https://hostelnavigator.online

# Anthropic Claude API (AI search, listing summaries, concierge).
# AI routes return 503 "not configured" when the key is unset. Only this explicit key is
# used - the server never falls back to other locally stored Claude credentials.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5, the lowest-cost current model)
ANTHROPIC_MODEL=
# Max AI requests per client IP per 15 minutes (default 30)
AI_RATE_LIMIT=30
# Max inquiry-form submissions per client IP per 15 minutes (default 5)
INQUIRY_RATE_LIMIT=5

# Only read by `npm run create-admin` (one-off; don't set these on Render)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# RapidAPI key for Indian PIN code lookup (used server-side by GET /api/postal-code/:pincode)
POSTALCODE_API_KEY=

# Email (optional; without it, emails are skipped and the contact form shows a mailto link).
# Option A - any SMTP provider (Brevo, SES, Zoho, Gmail, ...):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Option B - Gmail shortcut: account + app password (used only when SMTP_HOST is empty)
EMAIL_USER=
EMAIL_PASS=
# Sender shown to recipients, and the inbox that receives contact-form messages
EMAIL_FROM="HostelNavigator <no-reply@hostelnavigator.online>"
CONTACT_EMAIL=support@hostelnavigator.online
# Max contact-form submissions per client IP per 15 minutes (default 3)
CONTACT_RATE_LIMIT=3

# Cloud image storage (required once uploads move off MongoDB)
CLOUDINARY_URL=
